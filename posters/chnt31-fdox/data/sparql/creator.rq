PREFIX dct: <http://purl.org/dc/terms/>
PREFIX fdo: <https://w3id.org/fdo-squirrel/>
PREFIX schema: <https://schema.org/>

SELECT ?creator (COUNT(DISTINCT ?fdo) AS ?models)
WHERE {
  ?fdo a fdo:3DDataFDO ;
       dct:creator ?agent .
  ?agent schema:name ?creator .
}
GROUP BY ?creator
ORDER BY DESC(?models) ?creator
